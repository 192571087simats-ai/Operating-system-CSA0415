
#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main()
{
    int fd;
    struct stat s;
    DIR *d;
    struct dirent *entry;

    fd = open("test.txt", O_CREAT | O_RDWR, 0644);

    write(fd, "Hello World", 11);

    fcntl(fd, F_GETFL);

    lseek(fd, 0, SEEK_SET);

    stat("test.txt", &s);
    printf("File Size: %ld bytes\n", (long)s.st_size);

    close(fd);

    d = opendir(".");

    printf("Directory Files:\n");

    while((entry = readdir(d)) != NULL)
        printf("%s\n", entry->d_name);

    closedir(d);

    return 0;
}
