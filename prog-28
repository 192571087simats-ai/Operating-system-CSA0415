
#include <stdio.h>
#include <string.h>

int main()
{
    FILE *fp;
    char word[20], line[100];

    fp = fopen("file.txt", "r");

    if(fp == NULL)
    {
        printf("File not found");
        return 1;
    }

    printf("Enter word to search: ");
    scanf("%s", word);

    while(fgets(line, sizeof(line), fp))
    {
        if(strstr(line, word) != NULL)
            printf("%s", line);
    }

    fclose(fp);

    return 0;
}
