
#include <stdio.h>
#include <string.h>

int main()
{
    char files[10][20], name[20];
    int n, i;

    printf("Enter number of files: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("Enter file name: ");
        scanf("%s", files[i]);
    }

    printf("\nFiles in Directory:\n");

    for(i = 0; i < n; i++)
        printf("%s\n", files[i]);

    printf("\nEnter file to search: ");
    scanf("%s", name);

    for(i = 0; i < n; i++)
    {
        if(strcmp(files[i], name) == 0)
        {
            printf("File found");
            return 0;
        }
    }

    printf("File not found");

    return 0;
}
