
#include <stdio.h>
#include <sys/ipc.h>
#include <sys/msg.h>

struct msg
{
    long type;
    char text[100];
};

int main()
{
    int id;
    struct msg m;

    id = msgget(1234, 0666 | IPC_CREAT);

    m.type = 1;

    printf("Enter message: ");
    scanf("%s", m.text);

    msgsnd(id, &m, sizeof(m.text), 0);

    msgrcv(id, &m, sizeof(m.text), 1, 0);

    printf("Received message: %s\n", m.text);

    msgctl(id, IPC_RMID, NULL);

    return 0;
}
